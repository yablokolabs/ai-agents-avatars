# Deployer wallet. Use a throwaway key funded from the Amoy faucet:
# https://faucet.polygon.technology  (select Polygon Amoy)
PRIVATE_KEY=

# Optional: a dedicated RPC endpoint. Defaults to the public Amoy RPC.
AMOY_RPC_URL=

# Optional: enables automatic contract verification after deploy.
ETHERSCAN_API_KEY=

# Pinata JWT for pinning artwork and metadata. https://app.pinata.cloud
PINATA_JWT=

# Printed by `npm run ipfs:pin`. Immutable once deployed, so pin before deploying.
COLLECTION_CID=

# Mint price in POL. Defaults to 0.01.
MINT_PRICE=0.01

# Alternative to PINATA_JWT: the legacy key/secret pair from the same Pinata dashboard.
PINATA_API_KEY=
PINATA_API_SECRET=
